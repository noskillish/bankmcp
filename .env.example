# Every variable here is optional when you use the setup page on first run.
# Set them to configure by environment instead; they take precedence.

# --- Enable Banking application (https://enablebanking.com/cp/applications) ---
EB_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
# The private key that downloaded when you registered the application. Either
# a path to the .pem file, or its contents base64-encoded (for container hosts):
#   base64 -i app.pem | tr -d '\n'
EB_PRIVATE_KEY_PATH=./secrets/enablebanking.pem
# EB_PRIVATE_KEY=

# --- This server ---
# Public https URL. Enable Banking redirects here after a bank login and Claude
# connects here. Register ${BASE_URL}/callback as a redirect URL in the app.
BASE_URL=https://bank.example.com
PORT=8080
# Interface to bind. Default 0.0.0.0 (every interface), which is what container
# platforms need. With a proxy or a tunnel on the same machine in front, use:
# BIND_HOST=127.0.0.1

# Password for the OAuth login page (what you type when adding the connector).
# Recommended: a scrypt hash from `npm run hash-password`. ADMIN_PASSWORD works too.
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# Name shown on the sign-in and status pages
# APP_NAME=BankMCP™

# Default country for the bank picker (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY=DK

# Where the small state file lives (sessions, account ids, watches, tokens).
# Mount a volume here when running in a container.
DATA_DIR=./data

# --- Optional ---
# Hosts an OAuth client may redirect the sign-in back to. Defaults cover the
# well-known MCP clients (Claude, ChatGPT, Mistral, Cursor, VS Code) and
# localhost. Add your client's host if it is another one.
# ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,openai.com,mistral.ai,cursor.com,cursor.sh,vscode.dev,localhost,127.0.0.1
# Where watch notifications go. A Slack incoming webhook URL, or any URL that
# accepts a JSON POST.
# NOTIFY_WEBHOOK_URL=
# How often the background poller may check an account (hours). PSD2 allows
# four unattended checks per day, so keep this at 6 or more.
# POLL_INTERVAL_HOURS=6
# Terminate TLS in the process (e.g. running at home with a mkcert certificate).
# TLS_CERT_PATH=
# TLS_KEY_PATH=

# --- Account attestation (off by default) ---
# Signed yes/no answers about one IBAN, for a third party you are proving an
# account to. Adds no payment initiation and widens no consent. See ATTESTATION.md.
# ATTESTATION_ENABLED=1
# Highest threshold a "does it hold at least X?" question may ask about. Unset
# (the default) means no balance question is answered at all, only ownership:
# without a ceiling, a caller can binary-search your balance from yes/no answers.
# ATTESTATION_MAX_BALANCE=5000
# Include the name on the account. Off by default: it is personal data, and
# proving ownership does not need it.
# ATTESTATION_INCLUDE_HOLDER_NAME=1
# Attestations per hour, counted across the server. The ceiling above bounds
# what one answer reveals; this bounds how many answers a caller gets, and the
# two only work together. Default 30, far above what proving an account needs.
# Set to 0 to turn the limiter off, which gives up the ceiling with it.
# ATTESTATION_RATE_LIMIT=30
